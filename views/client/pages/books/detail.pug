extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/star.pug
include ../../mixins/alert.pug

block main 
  .col.py-5
    .d-flex.justify-content-center.mt-3
      aside.col-lg-5
        .rounded-4.mb-3.d-flex.justify-content-center
          a.rounded-4(data-fslightbox='mygalley' target='_blank' data-type='image' href=book.thumbnail)
            img.rounded-4.fit(style='width: 350px; height: 560px; margin: auto;' src=book.thumbnail)
      main.col-lg-6
        .ps-lg-3
          h2.title.text-dark.mb-4 #{book.title}
          .mb-2
            .d-flex
              div.me-5
                span.text-muted.me-2 Tác giả: 
                span #{book.author} 
              div 
                span.text-muted.me-2 Rating: 
                span 
                  +star(book.rating)
          .mb-2
            span.text-muted.me-2 Giá:
            span.h2.text-danger.fw-bold #{book.price} đ
          .mb-2
            span.text-muted.me-2 Thể loại:
            span #{book.category}
          .mb-3 
            span.text-muted.me-2 Description:
            if book.description
              span !{book.description}
            else 
              span Không có mô tả cho sản phẩm 
          
          hr 
          .col-md-3.col-lg-3.col-xl-2.d-flex
            button.btn.px-2(data-mdb-button-init='' data-mdb-ripple-init='' onclick="this.parentNode.querySelector('input[type=number]').stepDown()")
              i.fa.fa-minus
            input#form1.form-control.form-control-sm.text-center(min='1' name='quantity' value='1' type='number')
            button.btn.px-2(data-mdb-button-init='' data-mdb-ripple-init='' onclick="this.parentNode.querySelector('input[type=number]').stepUp()")
              i.fa.fa-plus
          .mt-4
            button.btn.btn-warning.shadow-0.me-3(link=`/cart/add/${book.id}`).btn-buy-now Buy now 
            button.btn.btn-primary.shadow-0(link=`/cart/add/${book.id}`).btn-add-cart
              i.me-1.fa.fa-shopping-basket
              |  Add to cart
  
  .container.mb-5.py-5
    .row.d-flex.justify-content-center
      .col-md-12.col-lg-10
        .card.text-body
          .card-body.p-4
            h4.mb-0 Recent comments
            p.fw-light.mb-4.pb-2 Latest Comments section by users

            if(comments)
              for comment in comments 
                .d-flex.flex-start.mb-3
                  img.rounded-circle.shadow-1-strong.me-3(src=comment.userInfo.avatar alt='avatar' width='60' height='60')
                  div
                    div
                      span.fw-bold.mb-1 #{comment.userInfo.fullName}
                      if user
                        if (user.id !== comment.userInfo.id)
                          a.ms-2(href=`/chat/${comment.userInfo.id}`)
                            i.fa.fa-commenting-o.fa-lg
                    .d-flex.align-items-center.mb-3
                      p.mb-0 #{comment.createdAtFormat}
                        span.badge.ms-2 
                          +star(comment.star)
                    p.mb-0 #{comment.body}
    
          .my-0
          .card-body.pt-2.pb-4
            if(user) 
              .d-flex.flex-start
                img.rounded-circle.shadow-1-strong.me-3(src=user.avatar alt='avatar' width='60' height='60')
                div
                  h6.fw-bold Add a comment
                  div(
                    style="width: 800px; height: 100px;"
                    form-comment
                    link=`/books/detail/${book.slug}/comment`
                  )
                    .mb-3
                      span#rate.mb-3
                        button(star-comment=1)
                          i.fa.fa-star.fa-sm.me-1
                        button(star-comment=2)
                          i.fa.fa-star.fa-sm.me-1
                        button(star-comment=3)
                          i.fa.fa-star.fa-sm.me-1
                        button(star-comment=4)
                          i.fa.fa-star.fa-sm.me-1
                        button(star-comment=5)
                          i.fa.fa-star.fa-sm.me-1

                    textarea.form-control(style='background: #fff; width: 100%; height: 100%' name="body")
                    .float-end.mt-2.pt-1
                      button.btn.btn-primary.btn-sm(submit-comment) Post comment
            else
              h6.ps-2 Đăng nhập để comment 

  include ../../partials/chat.pug
    

