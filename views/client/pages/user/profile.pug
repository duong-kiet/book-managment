extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ./info.pug
include ./order.pug

block main
  .container-xl.px-4.mt-4
    div 
      ul#pills-tab.nav(role='tablist')
        li.nav-item(role='presentation')
          h6#pills-profile-tab.nav-link.active.mb-0(data-bs-toggle='pill' data-bs-target='#pills-profile' role='tab' aria-controls='pills-profile' aria-selected='true') Profile 
        li.nav-item(role='presentation')
          h6#pills-order-tab.nav-link.mb-0(data-bs-toggle='pill' data-bs-target='#pills-order' type='button' role='tab' aria-controls='pills-order' aria-selected='false') Các đơn hàng của tôi
    
    hr.mt-0.mb-4

    #pills-tabContent.tab-content
      +info()
      +order()